{
  "cells": [
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "from pathlib import Path\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from pcntoolkit import (\n",
        "    HBR,\n",
        "    NormativeModel,\n",
        "    NormData,\n",
        "    plot_centiles,\n",
        "    plot_qq\n",
        ")\n",
        "\n",
        "import pcntoolkit.util.output\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# SETUP\n",
        "# ============================================================\n",
        "\n",
        "current_dir = Path.cwd().parent\n",
        "\n",
        "model_df = pd.read_csv(\n",
        "    current_dir\n",
        "    / \"results\"\n",
        "    / \"combined_dataset\"\n",
        "    / \"Model_dataframe.csv\"\n",
        ")\n",
        "\n",
        "pcntoolkit.util.output.Output.set_show_messages(True)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# DEFINE MODEL VARIABLES\n",
        "# ============================================================\n",
        "\n",
        "response_vars = [f\"comp{i}\" for i in range(1, 19)]\n",
        "\n",
        "batch_effects = [\n",
        "    \"Dataset_name\"\n",
        "]\n",
        "\n",
        "covariates = [\n",
        "    col for col in model_df.columns\n",
        "    if col not in (\n",
        "        [\"Scan_id\", \"Participant_Id\", \"Dataset_name\"]\n",
        "        + response_vars\n",
        "    )\n",
        "]\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# CREATE NORMDATA\n",
        "# ============================================================\n",
        "\n",
        "norm_data = NormData.from_dataframe(\n",
        "    name=\"DigitalRodent\",\n",
        "    dataframe=model_df,\n",
        "    covariates=covariates,\n",
        "    batch_effects=batch_effects,\n",
        "    response_vars=response_vars,\n",
        "    remove_Nan=False\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# TRAIN / TEST SPLIT\n",
        "# ============================================================\n",
        "\n",
        "train, test = norm_data.train_test_split()\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# HBR MODEL\n",
        "# ============================================================\n",
        "\n",
        "model = NormativeModel(\n",
        "    HBR(\n",
        "        name=\"DigitalRodent_HBR\",\n",
        "        cores=4,\n",
        "        chains=4,\n",
        "        draws=1500,\n",
        "        tune=500,\n",
        "        progressbar=True\n",
        "    ),\n",
        "    inscaler=\"standardize\",\n",
        "    outscaler=\"standardize\",\n",
        "    savemodel=True,\n",
        "    evaluate_model=True,\n",
        "    saveresults=True,\n",
        "    saveplots=True,\n",
        "    save_dir=str(\n",
        "        current_dir\n",
        "        / \"results\"\n",
        "        / \"normative_model\"\n",
        "        / \"HBR\"\n",
        "    )\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# FIT MODEL\n",
        "# ============================================================\n",
        "\n",
        "print(\"Starting HBR fit...\")\n",
        "model.fit_predict(\n",
        "    train,\n",
        "    test\n",
        ")\n",
        "print(\"HBR fit finished.\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# PLOTS\n",
        "# ============================================================\n",
        "\n",
        "plot_dir = (\n",
        "    current_dir\n",
        "    / \"results\"\n",
        "    / \"normative_model\"\n",
        "    / \"HBR\"\n",
        "    / \"plots\"\n",
        ")\n",
        "\n",
        "plot_dir.mkdir(\n",
        "    parents=True,\n",
        "    exist_ok=True\n",
        ")\n",
        "\n",
        "continuous_covariates = [\n",
        "    \"Age(week)\",\n",
        "    \"MRI\",\n",
        "    \"MRI T.R.\",\n",
        "    \"MRI T.E.\",\n",
        "    \"FD average\",\n",
        "    \"FD maximum\",\n",
        "    \"tSNR\"\n",
        "]\n",
        "\n",
        "# Only keep covariates that are actually present\n",
        "continuous_covariates = [\n",
        "    col for col in continuous_covariates\n",
        "    if col in covariates\n",
        "]\n",
        "\n",
        "for covariate in continuous_covariates:\n",
        "\n",
        "    plt.figure(figsize=(6, 4))\n",
        "\n",
        "    plot_centiles(\n",
        "        model,\n",
        "        scatter_data=train,\n",
        "        centiles=[0.05, 0.5, 0.95],\n",
        "        covariate=covariate,\n",
        "        scatter_kwargs={\n",
        "            \"s\": 10,\n",
        "            \"alpha\": 0.4\n",
        "        }\n",
        "    )\n",
        "\n",
        "    plt.title(f\"Centile plot: {covariate}\")\n",
        "    plt.tight_layout()\n",
        "\n",
        "    safe_name = (\n",
        "        covariate\n",
        "        .replace(\" \", \"_\")\n",
        "        .replace(\".\", \"_\")\n",
        "        .replace(\"/\", \"_\")\n",
        "        .replace(\"(\", \"\")\n",
        "        .replace(\")\", \"\")\n",
        "    )\n",
        "\n",
        "    plt.savefig(\n",
        "        plot_dir / f\"centiles_{safe_name}.png\",\n",
        "        dpi=300,\n",
        "        bbox_inches=\"tight\"\n",
        "    )\n",
        "\n",
        "    plt.show()\n",
        "    plt.close()\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# QQ PLOT\n",
        "# ============================================================\n",
        "\n",
        "plt.figure(figsize=(5, 5))\n",
        "\n",
        "plot_qq(\n",
        "    test,\n",
        "    plot_id_line=True\n",
        ")\n",
        "\n",
        "plt.title(\"QQ plot\")\n",
        "plt.tight_layout()\n",
        "\n",
        "plt.savefig(\n",
        "    plot_dir / \"qq_plot.png\",\n",
        "    dpi=300,\n",
        "    bbox_inches=\"tight\"\n",
        ")\n",
        "\n",
        "plt.show()\n",
        "plt.close()\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# RESULTS\n",
        "# ============================================================\n",
        "\n",
        "print(\"\\nTrain statistics:\")\n",
        "display(train.get_statistics_df())\n",
        "\n",
        "print(\"\\nTest statistics:\")\n",
        "display(test.get_statistics_df())\n",
        "\n",
        "plot_qq(\n",
        "    test,\n",
        "    plot_id_line=True\n",
        ")\n",
        "\n",
        "plt.show()"
      ],
      "id": "7573acf2",
      "execution_count": null,
      "outputs": []
    }
  ],
